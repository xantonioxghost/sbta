# ==============================================================================
# Posture Monitor - Supabase & Environment Configuration
# ==============================================================================
# Duplicate this file as .env (or configure in your deployment environment)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL Connection String (used by @workspace/db & Drizzle ORM)
# ------------------------------------------------------------------------------
# Found in: Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Use Transaction Pooler (port 6543) or Session Pooler (port 5432)
DATABASE_URL="postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[YOUR_REGION].pooler.supabase.com:6543/postgres"

# ------------------------------------------------------------------------------
# 2. Supabase API Credentials (used by Expo app & artifacts/posture-monitor)
# ------------------------------------------------------------------------------
# Found in: Supabase Dashboard -> Project Settings -> API
# Note: Variables prefixed with EXPO_PUBLIC_ are bundled into the Expo client.
EXPO_PUBLIC_SUPABASE_URL="https://[YOUR_PROJECT_REF].supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# ------------------------------------------------------------------------------
# 3. Optional Server-side Service Role Key (used by artifacts/api-server)
# ------------------------------------------------------------------------------
# Keep this secret! Never expose to client applications or prefix with EXPO_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ------------------------------------------------------------------------------
# 4. Optional Server Port
# ------------------------------------------------------------------------------
PORT=5000
